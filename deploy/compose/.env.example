# VaultSendアプリイメージ。本番ではタグではなくdigest固定を推奨。
VAULTSEND_IMAGE=ghcr.io/example/vaultsend@sha256:replace-me

# Docker Secretとしてマウントするホスト側ファイル。
AUDIT_WORKER_DATABASE_URL_FILE=./secrets/audit-worker-database-url
INTERNAL_METRICS_TOKEN_FILE=./secrets/internal-metrics-token
ALERTMANAGER_WEBHOOK_URL_FILE=./secrets/alertmanager-webhook-url
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana-admin-password

# APIコンテナと監視基盤が共有する、事前作成済みのinternal network。
VAULTSEND_MONITORING_NETWORK=vaultsend-monitoring

# 監視基盤イメージ。本番では検証済みdigestへ置き換える。
PROMETHEUS_IMAGE=prom/prometheus:v3.13.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.1
GRAFANA_IMAGE=grafana/grafana:13.1.0

PROMETHEUS_RETENTION=15d
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=vaultsend-admin
# 127.0.0.1へHTTP接続する検証時はfalse。本番HTTPS reverse proxy配下では必ずtrue。
GRAFANA_COOKIE_SECURE=false

AUDIT_OUTBOX_POLL_INTERVAL_SEC=2
AUDIT_OUTBOX_BATCH_SIZE=100
AUDIT_OUTBOX_RETENTION_HOURS=168
AUDIT_OUTBOX_CLEANUP_BATCH_SIZE=500
